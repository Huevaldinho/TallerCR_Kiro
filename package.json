{
  "name": "taller-pro-cr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:property": "jest --testNamePattern='Property'",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:dev": "docker-compose up --build",
    "docker:dev:detached": "docker-compose up --build -d",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up --build",
    "docker:down": "docker-compose down",
    "docker:clean": "docker-compose down -v --rmi all",
    "docker:logs": "docker-compose logs -f app",
    "supabase:local": "docker-compose --profile local-supabase up -d",
    "supabase:stop": "docker-compose --profile local-supabase down",
    "audit:fix": "npm audit fix",
    "update:check": "npm outdated",
    "setup": "npm install && npm run type-check && npm run lint",
    "ci": "npm ci && npm run type-check && npm run lint && npm run test"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^6.19.1",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/supabase-js": "^2.46.1",
    "@types/bcrypt": "^6.0.0",
    "@types/big.js": "^6.2.2",
    "@types/react-input-mask": "^3.0.5",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "bcrypt": "^6.0.0",
    "big.js": "^6.2.2",
    "date-fns": "^4.1.0",
    "next": "^14.2.15",
    "postcss": "^8.4.49",
    "prisma": "^6.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-input-mask": "^2.0.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-react": "^5.31.0",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "fast-check": "^3.22.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.3.3"
  },
  "overrides": {
    "glob": "^10.0.0",
    "rimraf": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
